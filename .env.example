# Copy to .env (git-ignored) and set real values. Share real values with the team privately,
# never in git, chat history or screenshots.

# SQL Server (hospital node). Must meet SQL Server complexity rules:
# 8+ characters with upper case, lower case, a digit and a symbol.
MSSQL_SA_PASSWORD=

# Application database user, created in SQL Server and TimescaleDB, used by Debezium
SERMON_DB_USER=sermon_admin
SERMON_DB_PASSWORD=

# TimescaleDB superuser (read by the official postgres/timescaledb image)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Grafana admin login (user: admin). Used by docker-compose.observability.yml
GRAFANA_ADMIN_PASSWORD=Shinchan
